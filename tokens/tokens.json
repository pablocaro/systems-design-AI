{
  "color": {
    "ink":    { "$type": "color", "$value": "#17181C" },
    "paper":  { "$type": "color", "$value": "#FFFFFF" },
    "panel":  { "$type": "color", "$value": "#DAD6C8" },
    "line":   { "$type": "color", "$value": "#B7B1A0" },
    "signal": { "$type": "color", "$value": "#FF5A1F" },
    "alt":    { "$type": "color", "$value": "#2F6F5E" }
  },
  "space": {
    "unit": { "$type": "dimension", "$value": "8px" },
    "xs":   { "$type": "dimension", "$value": "8px" },
    "sm":   { "$type": "dimension", "$value": "16px" },
    "md":   { "$type": "dimension", "$value": "24px" },
    "lg":   { "$type": "dimension", "$value": "40px" }
  },
  "radius": {
  "none": { "$type": "dimension", "$value": "0px" },
  "sm":   { "$type": "dimension", "$value": "2px" },
  "lg":   { "$type": "dimension", "$value": "12px" }
},
  "font": {
    "display": { "$type": "fontFamily", "$value": "'JetBrains Mono', monospace" },
    "body":    { "$type": "fontFamily", "$value": "'Inter', sans-serif" }
  },
  "theme": {
    "signal": { "accent": "{color.signal}", "label": "SIGNAL / #FF5A1F" },
    "alt":    { "accent": "{color.alt}",    "label": "ALT / #2F6F5E" }
  }
}
